# MongoDB Atlas Connection String
# Replace with your cluster connection URI from MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/findit?retryWrites=true&w=majority

# Secret key used to sign and verify JWT authentication tokens (use a random string >= 32 chars)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
